DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ── 订阅门禁（微信收款 · 服务器端码池 · 每年循环）─────────────────────
# 激活码池在 backend/data/activation_codes.json：一个码对应一年中的一个日子（月-日，
# 含闰日 02-29 共 366 个码），随机生成、不可伪造，只有当天能激活；激活后从今天起 30 天
# 有效。每年循环复用——同一天永远用同一个码，不需要每年重新生成。
# 查看/补全码池（管理员本机运行）：
#     cd backend && python generate_code.py          # 首次自动补齐全年，之后只查看
#     python generate_code.py 365                     # 补齐并展示从今天起 365 天
# 按天发码：顾客扫码付款后把"今天"的码发给他，一个码当天所有顾客共用。

# 未激活玩家可免费试玩的回合数。0 = 纯付费，不激活不能玩。
FREE_TRIAL_TURNS=5
